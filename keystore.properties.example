# 签名配置模板 —— 复制成 keystore.properties（同目录）再填自己的值。
#
# keystore.properties 含密码，已被 .gitignore 排除，不会出现在仓库里，
# 所以 clone 下来的项目默认没有它。缺少这个文件时：
#   - debug 构建照常可用（可以直接装到手机上调）
#   - release 构建会产出**未签名**的 APK，装不上；需要自己生成密钥后按下面的格式填好
#
# 生成一把自己的密钥（命名与路径随意，示例用 your-release.jks）：
#   keytool -genkeypair -keystore keystore/your-release.jks -alias youralias \
#     -keyalg RSA -keysize 4096 -validity 10000 \
#     -dname "CN=YourName, OU=YourProject, O=YourOrg, C=CN"
#
# 注意：
#   - 这把密钥要长期保存好，丢了以后已安装的旧版本就无法原地升级（只能卸载重装）
#   - 千万不要把 .jks 文件和本文件填好后的版本提交到仓库

# 密钥库文件，相对项目根目录
storeFile=keystore/your-release.jks

# 密钥库口令
storePassword=

# 密钥别名（keytool -genkeypair 时的 -alias）
keyAlias=

# 该别名的口令（多数情况下与密钥库口令相同）
keyPassword=
